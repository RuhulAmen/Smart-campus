# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/smart_campus
MONGO_DB_NAME=smart_campus

# JWT Configuration (generate a strong secret key for production)
SECRET_KEY=your-super-secret-jwt-key-here
JWT_EXPIRATION_HOURS=24

# CORS Settings
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Environment
DEBUG=True
